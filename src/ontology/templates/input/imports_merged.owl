    <!-- http://purl.obolibrary.org/obo/ENVO_02500028 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_02500028">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001346"/>
        <obo:IAO_0000115>An action of exogenic processes (such as water flow or wind) which remove environmental material from one part of a planet&apos;s crust, transporting it to another location where it is deposited.</obo:IAO_0000115>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/envo#envoPolar"/>
