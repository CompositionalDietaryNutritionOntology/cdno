        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>Monosaccharid</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Monosaccharide</oboInOwl:hasRelatedSynonym>
