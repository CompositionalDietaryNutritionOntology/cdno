            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A rigid covering that envelops an object.</obo:IAO_0000115>
        <rdfs:label>shell</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0007010 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0007010">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000922"/>
        <obo:IAO_0000115>Organism at the cleavage stage.</obo:IAO_0000115>
        <rdfs:label>cleaving embryo</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0007376 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0007376">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003102"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010371"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002202"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007383"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The epidermis is the entire outer epithelial layer of an animal, it may be a single layer that produces an extracellular material (e.g. the cuticle of arthropods) or a complex stratified squamous epithelium, as in the case of many vertebrate species[GO].</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>epidermis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>epidermis (sensu Metazoa)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>outer epidermal layer</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>outer epithelial layer</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>hypoderm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>hypodermis</oboInOwl:hasRelatedSynonym>
        <rdfs:label>outer epithelium</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0007383 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0007383">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000490"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005291"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010371"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002202"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000076"/>
