        <chemrof:monoisotopic_mass rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">180.06339</chemrof:monoisotopic_mass>
        <chemrof:smiles_string>[H]O[C@]1(CO)O[C@H](CO)[C@@H](O)[C@@H]1O</chemrof:smiles_string>
        <chemrof:wurcs_representation>WURCS=2.0/1,1,0/[ha122h-2b_2-5]/1/</chemrof:wurcs_representation>
