                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_64909"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An organic sodium salt consisting of sodium and oxalate ions in a 2:1 ratio.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>cas:62-76-0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pubmed:26898643</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pubmed:26974482</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pubmed:27064297</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pubmed:27085940</oboInOwl:hasDbXref>
