        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#TraitNet"/>
        <rdfs:comment>Refers to GO:0032502 &apos;developmental process&apos;, which includes growth, differentiation, and senescence, and BFO:0000003 &apos;ocurrent&apos;.</rdfs:comment>
        <rdfs:label>plant structure development stage</rdfs:label>
    </owl:Class>
