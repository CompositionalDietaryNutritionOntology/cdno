    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_24318 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_24318">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_15705"/>
