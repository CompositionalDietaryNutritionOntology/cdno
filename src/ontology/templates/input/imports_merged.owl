    <!-- http://purl.obolibrary.org/obo/CHEBI_26255 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_26255">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_25830"/>
        <obo:IAO_0000115>A quinone substituted by a polyprenyl-derived side-chain. Prenylquinones occur in all living cells. Due to their amphiphilic character, they are mainly located in biological membranes where they function as electron and proton carriers in the photosynthetic and respiratory electron transport chains. Some prenylquinones also perform more specialised roles sucy as antioxidants and enzyme cofactors. Prenylquinones are classified according to ring structure: the main classes are menaquinones, phylloquinones, ubiquinones and plastoquinones.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>CHEBI:72751</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>pubmed:19928587</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pubmed:21777468</oboInOwl:hasDbXref>
