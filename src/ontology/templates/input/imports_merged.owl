        <oboInOwl:id>PO:0000037</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#reference"/>
        <rdfs:label>shoot axis apex</rdfs:label>
    </owl:Class>
