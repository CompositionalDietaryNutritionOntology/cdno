        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A depression which is part of a planetary crust, is of geographic scale, and is partially or completely enclosed.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Basin</oboInOwl:hasDbXref>
