        <chemrof:mass rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">117.037</chemrof:mass>
        <chemrof:monoisotopic_mass rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">116.9824</chemrof:monoisotopic_mass>
        <chemrof:smiles_string>[1*]C(O)([2*]C(=O)[O-])C(=O)[O-]</chemrof:smiles_string>
