    <!-- http://purl.obolibrary.org/obo/CHEBI_17716 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_17716">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24405"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_77746"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A glycosylglucose disaccharide, found most notably in milk, that consists of &lt;small&gt;D&lt;/small&gt;-galactose and &lt;small&gt;D&lt;/small&gt;-glucose fragments bonded through a β-1→4 glycosidic linkage. The glucose fragment can be in either the α- or β-pyranose form, whereas the galactose fragment can only have the β-pyranose form.</obo:IAO_0000115>
