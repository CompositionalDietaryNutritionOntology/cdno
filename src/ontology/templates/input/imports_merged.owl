        <oboInOwl:hasRelatedSynonym>vitamins B2 vitamers</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>CHEBI:176838</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi/3_STAR"/>
        <rdfs:label>vitamin B2</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHEBI_176838"/>
