        <chemrof:generalized_empirical_formula>C7H11NO9S2R</chemrof:generalized_empirical_formula>
        <chemrof:mass rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">317.296</chemrof:mass>
        <chemrof:monoisotopic_mass rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">316.98752</chemrof:monoisotopic_mass>
        <chemrof:smiles_string>*/C(=N/OS(=O)(=O)[O-])S[C@@H]1O[C@H](CO)[C@@H](O)[C@H](O)[C@H]1O</chemrof:smiles_string>
