    <!-- http://purl.obolibrary.org/obo/CHEBI_189560 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_189560">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_18154"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0018038"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_18246"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Xanthan gum is a polysaccharide produced by the bacteria Xanthomonas campestris. It is composed of pentasaccharide repeat units, comprising two glucose units, two mannose units, and one glucuronic acid unit. Its main chain consists of β-&lt;small&gt;D&lt;/small&gt;-glucose units linked at the 1 and 4 positions. Trisaccharide side chains contain a &lt;small&gt;D&lt;/small&gt;-glucuronic acid unit between two &lt;small&gt;D&lt;/small&gt;-mannose units linked at the &lt;em&gt;O&lt;/em&gt;-3 position of every other glucose residue in the main chain. Approximately one-half of the terminal &lt;small&gt;D&lt;/small&gt;-mannose contains a pyruvic acid residue linked via keto group to the 4 and 6 positions, with an unknown distribution. &lt;small&gt;D&lt;/small&gt;-Mannose unit linked to the main chain contains an acetyl group at position &lt;em&gt;O&lt;/em&gt;-6.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>pubmed:14538095</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>xanthan</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>CHEBI:189560</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi/2_STAR"/>
        <rdfs:label>xanthan</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHEBI_189560"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget>pubmed:14538095</owl:annotatedTarget>
        <oboInOwl:source>pubmed</oboInOwl:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHEBI_189560"/>
