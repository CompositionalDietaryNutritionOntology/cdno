    <!-- http://purl.obolibrary.org/obo/CHEBI_166898 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_166898">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23055"/>
        <obo:IAO_0000115>Allomelanin is a type of nitrogen-free melanin most commonly found in fungi</obo:IAO_0000115>
        <oboInOwl:hasDbXref>pubmed:31524373</oboInOwl:hasDbXref>
