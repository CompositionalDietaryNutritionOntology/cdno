        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An action of exogenic processes (such as water flow or wind) which remove environmental material from one part of a planet&apos;s crust, transporting it to another location where it is deposited.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Erosion</oboInOwl:hasDbXref>
    </owl:Axiom>
    


