    <!-- http://purl.obolibrary.org/obo/CHEBI_166896 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_166896">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_47916"/>
        <obo:IAO_0000115>Peltogynoid compounds, differing from other flavonoids by the presence of a fourth ring, have been isolated from a small group of species, however, their biological activities remain to be defined.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
