        <oboInOwl:hasRelatedSynonym>monosacarido</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>monosacaridos</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>monosaccharides</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>CHEBI:35381</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi/3_STAR"/>
        <rdfs:label>monosaccharide</rdfs:label>
    </owl:Class>
