        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi/3_STAR"/>
        <rdfs:label>octadecatrienoate</rdfs:label>
        <chemrof:charge rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1</chemrof:charge>
        <chemrof:generalized_empirical_formula>C18H29O2</chemrof:generalized_empirical_formula>
        <chemrof:mass rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">277.423</chemrof:mass>
        <chemrof:monoisotopic_mass rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">277.21676</chemrof:monoisotopic_mass>
        <chemrof:smiles_string>*C(=O)[O-]</chemrof:smiles_string>
    </owl:Class>
