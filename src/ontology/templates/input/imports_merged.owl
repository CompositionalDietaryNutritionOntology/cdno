                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002500"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_02500003"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002220"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001682"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A gaseous front which separates two masses of air with different densities and is a principal cause of meteorological phenomena.</obo:IAO_0000115>
        <dc:creator rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-07-22T17:57:21Z</dc:date>
        <oboInOwl:hasExactSynonym>meteorological front</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/envo#envoAtmo"/>
        <rdfs:comment>This class refers to Earth&apos;s weather fronts. Other forms, not composed of air, are present on other planets and can be created on request. Note: &quot;Since the temperature distribution is the most important regulator of atmospheric density, a front almost invariably separates air masses of different temperature. Along with the basic density criterion and the common temperature criterion, many other features may distinguish a front, such as a pressure trough, a change in wind direction, a moisture discontinuity, and certain characteristic cloud and precipitation forms.&quot;</rdfs:comment>
        <rdfs:label xml:lang="en">weather front</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001681"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A gaseous front which separates two masses of air with different densities and is a principal cause of meteorological phenomena.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="http://glossary.ametsoc.org/wiki/Front"/>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Weather_front"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001681"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget>This class refers to Earth&apos;s weather fronts. Other forms, not composed of air, are present on other planets and can be created on request. Note: &quot;Since the temperature distribution is the most important regulator of atmospheric density, a front almost invariably separates air masses of different temperature. Along with the basic density criterion and the common temperature criterion, many other features may distinguish a front, such as a pressure trough, a change in wind direction, a moisture discontinuity, and certain characteristic cloud and precipitation forms.&quot;</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="http://glossary.ametsoc.org/wiki/Front"/>
    </owl:Axiom>
    


