        <obo:IAO_0000115>A marine ecosystem which is in its climactic successional state.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>SPIRE:Marine</oboInOwl:hasDbXref>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/ENVO_03605017"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/ENVO_03605021"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/ENVO_03605022"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/envo#envoPolar"/>
        <rdfs:comment>This biome includes open-ocean and unprotected coastal ecosystems, characterized by exposure to wave action, tidal fluctuation, and ocean currents as well as systems that largely resemble these. Water in the marine biome is generally within the salinity range of seawater: 30 to 38 ppt.</rdfs:comment>
        <rdfs:label>marine biome</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000447"/>
