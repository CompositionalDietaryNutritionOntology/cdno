    <!-- http://purl.obolibrary.org/obo/CHEBI_139358 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_139358">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23367"/>
        <obo:IAO_0000115>Any molecular entity in which the isotopic ratio of nuclides for at least one element deviates measurably from that occurring in nature. The term includes both &lt;em&gt;isotopically substituted&lt;/em&gt; compounds (in which essentially all the molecules of the compound have only the indicated nuclide(s) at each designated position) and &lt;em&gt;isotopically labeled&lt;/em&gt; compounds (a formal mixture of an isotopically unmodified compound with one or more analogous isotopically substituted compound(s).</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>isotopically modified compounds</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>CHEBI:139358</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi/3_STAR"/>
        <rdfs:label>isotopically modified compound</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHEBI_139358"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>isotopically modified compounds</owl:annotatedTarget>
        <oboInOwl:hasDbXref>chebi</oboInOwl:hasDbXref>
    </owl:Axiom>
    


