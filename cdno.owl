    <!-- http://purl.obolibrary.org/obo/CHEBI_26377 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_26377">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_50753"/>
        <obo:IAO_0000115>Members of the class of benzofurochromene with a 6a,11a-dihydro-6&lt;em&gt;H&lt;/em&gt;-[1]benzofuro[3,2-&lt;em&gt;c&lt;/em&gt;]chromene skeleton and its substituted derivatives. They generally bear structural resemblance to isoflavanoids that possess antibiotic activity and are produced by plant tissues in response to infection. They are the 3,4-dihydroderivatives of coumestans.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>CHEBI:60953</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>metacyc.compound:PTEROCARPANS</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>wikipedia.en:Pterocarpan</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>isoflavonoid phytoalexin</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>isoflavonoid phytoalexins</oboInOwl:hasRelatedSynonym>
