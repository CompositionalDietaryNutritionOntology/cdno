    <!-- http://purl.obolibrary.org/obo/CHEBI_17020 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_17020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_61266"/>
        <obo:IAO_0000115>A heteroglycan consisting of β-(1→4)-linked &lt;small&gt;D&lt;/small&gt;-glucose (G) and &lt;small&gt;D&lt;/small&gt;-mannose (M) in a proportion of 5:8. The basic polymeric repeating unit has the pattern: GGMMGMMMMMGGM, with branching through β-(1→3)- and β-(1→6)-glucosyl linkages. Acetate groups are present on C-6 every 9-19 units of the main chain.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>CHEBI:11105</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>CHEBI:11106</oboInOwl:hasAlternativeId>
