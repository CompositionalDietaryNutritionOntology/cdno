        <oboInOwl:hasDbXref>drugbank:DB07715</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>kegg.compound:C10343</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>knapsack:C00000555</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>lincs.smallmolecule:LSM-18994</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>lipidmaps:LMPK13040008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pdb-ccd:EMO</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pubmed:12563347</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pubmed:12657721</oboInOwl:hasDbXref>
