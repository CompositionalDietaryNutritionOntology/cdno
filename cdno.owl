        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>xanthan</owl:annotatedTarget>
        <oboInOwl:hasDbXref>uniprot_ft</oboInOwl:hasDbXref>
    </owl:Axiom>
    


