    <!-- http://purl.obolibrary.org/obo/CHEBI_33229 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_33229">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0500002"/>
        <obo:IAO_0000115>A biochemical role played by any micronutrient that is an organic compound. Vitamins are present in foods in small amounts and are essential to normal metabolism and biochemical functions, usually as coenzymes. The term &quot;vitamines&quot; (from &lt;em&gt;vita&lt;/em&gt; + amines) was coined in 1912 by Casimir Funk, who believed that these compounds were amines.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>CHEBI:10004</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>CHEBI:27305</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>wikipedia.en:Vitamin</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>vitamin</oboInOwl:hasRelatedSynonym>
