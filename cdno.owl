    <!-- http://purl.obolibrary.org/obo/CHEBI_145829 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_145829">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_47916"/>
        <obo:IAO_0000115>An aryl β-&lt;small&gt;D&lt;/small&gt;-glucoside that is phloretin attached to a β-&lt;small&gt;D&lt;/small&gt;-glucopyranosyl residue at position 4&apos; via a glycosidic linkage. It is isolated from the leaves of the Chinese sweet tea &lt;em&gt;Lithocarpus polystachyus&lt;/em&gt; and exhibits significant anti-hyperglycemic, anti-oxidative and anti-inflammatory properties.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>agr:IND601124268</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>agr:IND605946551</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>agr:IND606090210</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>cas:4192-90-9</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>foodb.food:FDB016580</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>hmdb:HMDB0037505</oboInOwl:hasDbXref>
