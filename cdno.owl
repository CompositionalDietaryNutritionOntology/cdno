    <!-- http://purl.obolibrary.org/obo/CHEBI_5623 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_5623">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_22315"/>
        <obo:IAO_0000115>An indole alkaloid fundamental parent with a structure of 9&lt;em&gt;H&lt;/em&gt;-β-carboline carrying a methyl substituent at C-1. It has been isolated from the bark of &lt;em&gt;Sickingia rubra&lt;/em&gt;, &lt;em&gt;Symplocus racemosa&lt;/em&gt;, &lt;em&gt;Passiflora incarnata&lt;/em&gt;, &lt;em&gt;Peganum harmala&lt;/em&gt;, &lt;em&gt;Banisteriopsis caapi&lt;/em&gt; and &lt;em&gt;Tribulus terrestris&lt;/em&gt;, as well as from tobacco smoke. It is a specific, reversible inhibitor of monoamine oxidase A.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>cas:486-84-0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>kegg.compound:C09209</oboInOwl:hasDbXref>
