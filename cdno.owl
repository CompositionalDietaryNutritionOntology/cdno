    <!-- http://purl.obolibrary.org/obo/CHEBI_15864 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_15864">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_42491"/>
        <obo:IAO_0000115>A tetrahydroxyflavone in which the four hydroxy groups are located at positions 3&apos;, 4&apos;, 5 and 7. It is thought to play an important role in the human body as an antioxidant, a free radical scavenger, an anti-inflammatory agent and an immune system modulator as well as being active against several cancers.</obo:IAO_0000115>
