        <oboInOwl:hasRelatedSynonym>vitamins B5</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>CHEBI:176840</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi/3_STAR"/>
        <rdfs:label>vitamin B5</rdfs:label>
    </owl:Class>
    <owl:Axiom>
