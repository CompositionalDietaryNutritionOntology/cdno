    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_66046">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_2197"/>
        <obo:IAO_0000115>A glycosyloxyflavone that is 6-hydroxyluteolin attached to a β-&lt;small&gt;D&lt;/small&gt;-glucopyranosyl-(1→3)-β-&lt;small&gt;D&lt;/small&gt;-glucopyranosyl moiety at position 7 via a glycosidic linkage. Isolated from &lt;em&gt;Globularia cordifolia&lt;/em&gt; and &lt;em&gt;Globularia alypum&lt;/em&gt;, it exhibits antioxidant activity.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>pubmed:16124783</oboInOwl:hasDbXref>
