    <!-- http://purl.obolibrary.org/obo/CHEBI_176841 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_176841">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_75769"/>
        <obo:IAO_0000115>Any member of a group of vitamers that belong to the chemical structural class called biotins that exhibit biological activity against vitamin B&lt;small&gt;&lt;sub&gt;7&lt;/sub&gt;&lt;/small&gt; deficiency. Vitamin B&lt;small&gt;&lt;sub&gt;7&lt;/sub&gt;&lt;/small&gt; deficiency is very rare in individuals who take a normal balanced diet. Foods rich in biotin are egg yolk, liver, cereals, vegetables (spinach, mushrooms) and rice. Symptoms associated with vitamin B&lt;small&gt;&lt;sub&gt;7&lt;/sub&gt;&lt;/small&gt; deficiency include thinning hair, scaly skin rashes around eyes, nose and mouth, and brittle nails. The vitamers include biotin and its ionized and salt forms.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>vitamin B-7</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>vitamin B7</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>vitamin B7 vitamer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>vitamin B7 vitamers</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>vitamins B7</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>CHEBI:176841</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi/3_STAR"/>
        <rdfs:label>vitamin B7</rdfs:label>
    </owl:Class>
    <owl:Axiom>
