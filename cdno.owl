    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_4932">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24698"/>
        <obo:IAO_0000115>A trimethoxyflavone that is flavone substituted by hydroxy groups at C-5 and C-7 and methoxy groups at C-6, C-3&apos; and C-4&apos; respectively. Isolated from &lt;em&gt;Citrus reticulata&lt;/em&gt; and &lt;em&gt;Salvia tomentosa&lt;/em&gt;, it exhibits anti-inflammatory, anti-ulcer and antineoplastic activities.</obo:IAO_0000115>
