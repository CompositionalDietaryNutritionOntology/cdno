    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_145022">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26873"/>
        <obo:IAO_0000115>A rebaudioside that is rebaudioside A in which the hydroxy group at position 2 of the β-&lt;small&gt;D&lt;/small&gt;-glucosyl ester moiety has been converted to the corresponding β-&lt;small&gt;D&lt;/small&gt;-glucoside. Found in minute quantities in the leaves of &lt;em&gt;Stevia rebaudiana&lt;/em&gt;.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>cas:63279-13-0</oboInOwl:hasDbXref>
