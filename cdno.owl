    <!-- http://purl.obolibrary.org/obo/CHEBI_75832 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_75832">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_190420"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24840"/>
        <obo:IAO_0000115>A compound of iron and sulfate in which the ratio of iron(2+) to sulfate ions is 1:1. Various hydrates occur naturally - most commonly the heptahydrate, which loses water to form the tetrahydrate at 57°C and the monohydrate at 65°C.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>cas:7720-78-7</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>metacyc.compound:CPD0-2386</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ppdb:1399</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>reaxys:4933679</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>wikipedia.en:Iron(II)_sulfate</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">ferrous sulfate</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>iron(2+) sulfate</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>Fe(II)SO4</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>FeSO4</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ferrous sulfate</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ferrous sulfate (anh.)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ferrous sulfate (anhydrous)</oboInOwl:hasRelatedSynonym>
