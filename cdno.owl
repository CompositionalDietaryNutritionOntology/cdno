    <!-- http://purl.obolibrary.org/obo/CHEBI_67347 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_67347">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26377"/>
        <obo:IAO_0000115>A member of the class of pterocarpans that is the 3-&lt;em&gt;O&lt;/em&gt;-methyl ether of (+)-6a-hydroxymaackiain (the 6a&lt;i&gt;R&lt;/i&gt;,12a&lt;i&gt;R&lt;/i&gt; stereoisomer). A phytoalexin found in pods of garden peas (&lt;em&gt;Pisum sativum&lt;/em&gt;) and other plants of the pea family, including &lt;em&gt;Tephrosia candida&lt;/em&gt;.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>CHEBI:8250</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>cas:469-01-2</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>hmdb:HMDB0033732</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>kegg.compound:C10516</oboInOwl:hasDbXref>
